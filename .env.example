# ===============================================
# DocuMind AI - Django Backend Environment
# ===============================================

# Django Core Security
SECRET_KEY=change-to-a-secure-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# CORS Configuration (comma-separated allowed origins, never use wildcard '*' in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com

# AI & LLM Provider (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ChromaDB Vector Store
CHROMA_PERSIST_DIR=/app/chroma_data
CHROMA_COLLECTION_NAME=documind_vectors

# RAG Partitioning Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
